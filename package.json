{
  "name": "dsh-plugin-cards",
  "version": "0.9.8",
  "description": "DeepSeek Harness (dsh) 设置卡片 + 对话节点插件",
  "license": "MIT",
  "author": "yuanzukun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanzukun/dsh-plugin-cards.git"
  },
  "homepage": "https://github.com/yuanzukun/dsh-plugin-cards#readme",
  "bugs": "https://github.com/yuanzukun/dsh-plugin-cards/issues",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "settings-card",
    "conversation-node"
  ],
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "build": "tsdown && node -e \"require('fs').accessSync('lib/client.js'); console.log('client.js present OK')\"",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engine": "dsh >=0.1.7-rc.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
